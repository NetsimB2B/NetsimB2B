FIREBIRD_ROOT_PASSWORD=change-me-local-only
FIREBIRD_DATABASE=NETSIM_B2B.FDB
# Salt-okunur Netsim ERP verisi (ürün, cari, fiyat...). Yerel geliştirmede
# database/firebird/netsim-dev/README.md'deki mock veritabanını gösterin.
ConnectionStrings__Netsim=User=SYSDBA;Password=change-me-local-only;Database=/var/lib/firebird/data/NETSIM_DEV.FDB;DataSource=localhost;Port=3051;Dialect=3;Charset=UTF8;Pooling=true;
# B2B'nin kendi veritabanı (B2B_USERS, B2B_CARTS...) — compose.yaml'daki "firebird" servisi.
# Host'unuzda 3050 doluysa compose.yaml'daki port eşlemesini değiştirip burayı da güncelleyin.
# NOT: "Database" yalnızca dosya yolu olmalı — DataSource/Port ayrıca verildiğinde
# "host/port:yol" biçimi FirebirdSql.Data.FirebirdClient 10.x'te yanlış parse ediliyor
# (doğrulandı: "I/O error ... file localhost\3050" hatası veriyor).
ConnectionStrings__B2B=User=SYSDBA;Password=change-me-local-only;Database=/var/lib/firebird/data/NETSIM_B2B.FDB;DataSource=localhost;Port=3050;Dialect=3;Charset=UTF8;Pooling=true;
Cors__AllowedOrigins__0=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5080/api

